from pathlib import Path
import pandas as pd

# À adapter avec ton véritable chemin OneDrive
racine = Path(r"C:\Users\almou\OneDrive\GeoMarketing_IDF\data")

fichier_pop = racine / "raw/insee/rp2022/communes/population/base-cc-evol-struct-pop-2022.CSV"
fichier_cog = racine / "raw/insee/cog2025/v_commune_2025.csv"

# Chargement
population = pd.read_csv(
    fichier_pop,
    sep=";",
    dtype={"CODGEO": "string"},
    low_memory=False
)

cog = pd.read_csv(
    fichier_cog,
    sep=",",
    dtype={
        "COM": "string",
        "REG": "string",
        "DEP": "string",
        "COMPARENT": "string"
    }
)

communes = (
    cog.loc[
        cog["TYPECOM"] == "COM",
        ["COM", "LIBELLE", "REG", "DEP"]
    ]
    .drop_duplicates(subset="COM")
)

assert communes["COM"].is_unique

population_jointe = population.merge(
    communes,
    how="left",
    left_on="CODGEO",
    right_on="COM",
    validate="one_to_one",
    indicator=True
)

